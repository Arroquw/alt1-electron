{
	"name": "alt1lite",
	"version": "0.0.1",
	"description": "Lightweight cross-platform client for Alt1 Toolkit apps",
	"repository": "https://github.com/skillbert/alt1-electron.git",
	"license": "GPL-3.0",
	"author": "",
	"main": "./dist/alt1lite.bundle.js",
	"scripts": {
		"build": "webpack --config ./webpack.config.cjs",
		"dist": "npm run dist:$(node -p \"process.platform\")",
		"dist:linux": "electron-builder -l",
		"dist:darwin": "electron-builder -m",
		"dist:win32": "electron-builder -w",
		"install": "npm run native",
		"postinstall": "electron-builder install-app-deps",
		"native": "npm run nativerelease -- --debug",
		"nativerelease": "electron-rebuild -f -w alt1lite",
		"release": "npm run build -- -p",
		"ui": "electron --inspect=9228 ./dist/alt1lite.bundle.js",
		"watch": "npm run build -- --watch"
	},
	"dependencies": {
		"@types/node-fetch": "^2.5.8",
		"@types/react": "^17.0.0",
		"@types/react-dom": "^17.0.0",
		"alt1": "^0.1.1",
		"autobind-decorator": "^2.4.0",
		"classnames": "^2.2.6",
		"css-loader": "^5.0.1",
		"file-loader": "^6.2.0",
		"json-loader": "^0.5.7",
		"nan": "^2.14.2",
		"node-addon-api": "^7.0.0",
		"node-fetch": "^2.6.1",
		"react": "^17.0.1",
		"react-dom": "^17.0.1",
		"sass": "^1.56.1",
		"sass-loader": "^10.1.1",
		"sharp": "^0.33.4",
		"style-loader": "^2.0.0",
		"url-loader": "^4.1.1"
	},
	"devDependencies": {
		"electron": "^35.5.1",
		"electron-builder": "^26.0.12",
		"@electron/rebuild": "^3.7.2",
		"@electron/asar": "^3.4.1",
		"@electron/remote": "^2.0.8",
		"ts-loader": "^8.0.14",
		"typescript": "^5.7.3",
		"webpack": "^5.104.1",
		"webpack-cli": "^5.1.4"
	},
	"build": {
		"appId": "com.example.alt1lite",
		"productName": "Alt1Lite",
		"files": [
			"dist/**/*",
			"node_modules/**/*",
			"package.json",
			"build/*/*.node"
		],
		"directories": {
			"output": "release"
		},
		"linux": {
			"target": [
				"AppImage"
			]
		},
		"win": {
			"target": [
				"portable"
			]
		},
		"mac": {
			"target": [
				"zip"
			]
		}
	}
}
