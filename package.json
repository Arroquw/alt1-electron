{
	"name": "alt1lite",
	"version": "0.0.1",
	"description": "Lightweight cross-platform client for Alt1 Toolkit apps",
	"main": "index.ts",
	"scripts": {
		"build": "webpack --config ./webpack.config.cjs",
		"release": "npm run build -- -p",
		"watch": "npm run build -- --watch",
		"ui": "electron --inspect=9228 ./dist/alt1lite.bundle.js",
		"native": "npm run nativerelease -- --debug",
		"nativerelease": "electron-rebuild -f -w alt1lite",
		"install": "npm run native"
	},
	"author": "",
	"license": "GPL-3.0",
	"devDependencies": {
		"@types/node-fetch": "^2.5.8",
		"@types/react": "^17.0.0",
		"@types/react-dom": "^17.0.0",
		"@electron/asar": "^3.4.1",
		"@electron/rebuild": "^3.7.2",
		"alt1": "^0.1.1",
		"autobind-decorator": "^2.4.0",
		"classnames": "^2.2.6",
		"css-loader": "^5.0.1",
		"file-loader": "^6.2.0",
		"json-loader": "^0.5.7",
		"nan": "^2.14.2",
		"node-addon-api": "^7.0.0",
		"sass": "^1.56.1",
		"sass-loader": "^10.1.1",
		"style-loader": "^2.0.0",
		"ts-loader": "^8.0.14",
		"typescript": "^5.7.3",
		"url-loader": "^4.1.1",
		"webpack": "^5.104.1",
		"webpack-cli": "^5.1.4"
	},
	"dependencies": {
		"@electron/remote": "^2.0.8",
		"electron": "^35.5.1",
		"node-fetch": "^2.6.1",
		"react": "^17.0.1",
		"react-dom": "^17.0.1",
		"sharp": "^0.33.4"
	},
	"repository": "https://github.com/skillbert/alt1-electron.git"
}
